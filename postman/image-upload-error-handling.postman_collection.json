{
  "info": {
    "name": "Veebipood - Image Upload Error Handling",
    "description": "Verifies product image upload succeeds within the configured multipart size limit and returns a clean 413 JSON error when it's exceeded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "postmantestuser" },
    { "key": "password", "value": "pass1234" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register test user (ignore 409 if it already exists)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"postmantest@example.com\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create test product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Product\",\n  \"price\": 9.99,\n  \"stock\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('productId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Upload image WITHIN limit (expect 200)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/products/{{productId}}/image",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/Users/anastasijaselevjorstova/IdeaProjects/veebipood-backend/postman/test-image-within-limit.jpg"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 (upload succeeds)', () => pm.response.to.have.status(200));",
              "pm.test('Response has imageContentType', () => {",
              "    pm.expect(pm.response.json().imageContentType).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Upload image OVER limit (expect 413)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/products/{{productId}}/image",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/Users/anastasijaselevjorstova/IdeaProjects/veebipood-backend/postman/test-image-over-limit.jpg"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 413', () => pm.response.to.have.status(413));",
              "const json = pm.response.json();",
              "pm.test('Body has status/error/message/path', () => {",
              "    pm.expect(json).to.have.property('status', 413);",
              "    pm.expect(json).to.have.property('error');",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json).to.have.property('path');",
              "});",
              "pm.test('Message mentions size', () => {",
              "    pm.expect(json.message.toLowerCase()).to.include('too large');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
